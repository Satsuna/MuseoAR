    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: " /_\u4E00\u4E0B\u4E2D\u4E8E\u4EA4\u4EE5\u4EF6\u4F53\u4F7F\u4FE1\u5165\u5173\u5185\u518C\u51FA\u522B\u5237\u52A9\u53CD\u53D1\u53F7\u548C\u56FD\u5728\u591A\u5973\u59CB\u5BB9\u5BC6\u5C06\u5C0F\u5DF2\u5E2E\u5F00\u5F55\u6027\u606F\u60A8\u6211\u62E9\u63D0\u6539\u6587\u65B0\u663E\u66F4\u6709\u672C\u6761\u6B3E\u6B65\u6CA1\u6CE8\u6D4B\u7528\u7537\u753B\u767B\u7684\u7801\u786E\u793A\u79CD\u7B80\u7BB1\u7C4D\u7ED8\u7F6E\u8A00\u8BA4\u8BBE\u8BED\u8BEF\u8BF7\u8BFB\u8D26\u8F93\u8FD8\u8FD9\u9001\u9009\u90AE\u91CC\u9519\u9605\u9988\u9A8C\uFF1F<b>1.
      \u6761\u6B3E\u63A5\u53D7</b> \u901A\u8FC7\u4E0B\u8F7D\u3001\u8BBF\u95EE\u6216\u4F7F\u7528MuseoAR\u79FB\u52A8\u5E94\u7528\u7A0B\u5E8F\uFF08\u201CApp\u201D\uFF09\uFF0C\u60A8\u5373\u8868\u793A\u540C\u610F\u53D7\u672C\u6761\u6B3E\u4E0E\u6761\u4EF6\u7684\u7EA6\u675F\u3002\u5982\u679C\u60A8\u4E0D\u540C\u610F\u8FD9\u4E9B\u6761\u6B3E\uFF0C\u8BF7\u4E0D<b>1.
      \u6761\u6B3E\u7684\u63A5\u53D7</b>  \r\n\u901A\u8FC7\u4E0B\u8F7D\u3001\u8BBF\u95EE\u6216\u4F7F\u7528MuseoAR\u79FB\u52A8\u5E94\u7528\u7A0B\u5E8F\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201CApp\u201D\uFF09\uFF0C\u60A8\u540C\u610F\u53D7\u672C\u6761\u6B3E\u548C\u6761\u4EF6\u7684\u7EA6\u675F\u3002 
      \r\n\u5982\u679C\u60A8\u4E0D\u540C\u610F\u8FD9\u4E9B\u6761\u6B3E\uFF0C\u8BF7\u4E0D\u8981\u4F7F\u7528\u672CApp\u3002 
      \r\n\r\n<b>2. \u670D\u52A1\u8BF4\u660E</b>  \r\nMuseoAR\u662F\u4E00\u6B3E\u589E\u5F3A\u73B0\u5B9E\uFF08AR\uFF09\u79FB\u52A8\u5E94\u7528\u7A0B\u5E8F\uFF0C\u65E8\u5728\u901A\u8FC7\u63D0\u4F9B\u4E92\u52A8\u7684\u591A\u8BED\u8A00\u6587\u7269\u4E0E\u5C55\u54C1\u4FE1\u606F\u6765\u63D0\u5347\u535A\u7269\u9986\u4F53\u9A8C\u3002 
      \r\n\u672CApp\u4EC5\u7528\u4E8E\u4FE1\u606F\u548C\u6559\u80B2\u76EE\u7684\u3002 
      \r\n\r\n<b>3. \u7528\u6237\u4E49\u52A1</b>  \r\n\u60A8\u540C\u610F\u6309\u7167\u6240\u6709\u9002\u7528\u7684\u6CD5\u5F8B\u548C\u6CD5\u89C4\u4F7F\u7528\u672CApp\u3002 
      \r\n\u60A8\u4E0D\u5F97\u4EE5\u4EFB\u4F55\u53EF\u80FD\u635F\u5BB3\u5176\u529F\u80FD\u6216\u5176\u4ED6\u7528\u6237\u8BBF\u95EE\u6743\u7684\u65B9\u5F0F\u6EE5\u7528\u672CApp\u3002 
      \r\n\r\n<b>4. \u77E5\u8BC6\u4EA7\u6743</b>  \r\n\u672CApp\u5185\u7684\u6240\u6709\u5185\u5BB9\uFF0C\u5305\u62EC\u4F46\u4E0D\u9650\u4E8E\u6587\u5B57\u3001\u56FE\u5F62\u3001\u56FE\u50CF\u3001\u8F6F\u4EF6\u548C\u591A\u5A92\u4F53\uFF0C\u5747\u4E3AMuseoAR\u6216\u5176\u8BB8\u53EF\u65B9\u7684\u77E5\u8BC6\u4EA7\u6743\u3002 
      \r\n\u672A\u7ECF\u4E8B\u5148\u4E66\u9762\u540C\u610F\uFF0C\u60A8\u4E0D\u5F97\u4FEE\u6539\u3001\u5206\u53D1\u3001\u590D\u5236\u6216\u5C06\u4EFB\u4F55\u5185\u5BB9\u7528\u4E8E\u5546\u4E1A\u76EE\u7684\u3002 
      \r\n\r\n<b>5. \u9690\u79C1\u4E0E\u6570\u636E\u6536\u96C6</b>  \r\n\u672CApp\u53EF\u80FD\u4F1A\u6536\u96C6\u8BED\u8A00\u504F\u597D\u3001\u626B\u63CF\u5386\u53F2\u548C\u8BBE\u5907\u4FE1\u606F\u7B49\u6570\u636E\uFF0C\u4EE5\u63D0\u5347\u7528\u6237\u4F53\u9A8C\u3002 
      \r\n\u8BE6\u7EC6\u4FE1\u606F\u8BF7\u53C2\u9605\u6211\u4EEC\u7684\u9690\u79C1\u653F\u7B56\u3002 
      \r\n\u6211\u4EEC\u627F\u8BFA\u4FDD\u62A4\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF0C\u5E76\u786E\u4FDD\u5176\u88AB\u8D1F\u8D23\u4EFB\u5730\u4F7F\u7528\u3002 
      \r\n\r\n<b>6. \u8D23\u4EFB\u9650\u5236</b>  \r\nMuseoAR\u53CA\u5176\u5F00\u53D1\u8005\u5BF9\u4E8E\u56E0\u4F7F\u7528\u6216\u65E0\u6CD5\u4F7F\u7528\u672CApp\u800C\u4EA7\u751F\u7684\u4EFB\u4F55\u76F4\u63A5\u3001\u95F4\u63A5\u3001\u9644\u5E26\u3001\u7279\u6B8A\u6216\u540E\u679C\u6027\u635F\u5BB3\u4E0D\u627F\u62C5\u8D23\u4EFB\u3002 
      \r\n\u672CApp\u53EF\u80FD\u5305\u542B\u6307\u5411\u7B2C\u4E09\u65B9\u7F51\u7AD9\u7684\u94FE\u63A5\u4EE5\u63D0\u4F9B\u989D\u5916\u8D44\u6E90\u3002 
      \r\nMuseoAR\u4E0D\u5BF9\u8FD9\u4E9B\u5916\u90E8\u7F51\u7AD9\u7684\u5185\u5BB9\u6216\u53EF\u7528\u6027\u8D1F\u8D23\u3002 
      \r\n\r\n<b>7. \u66F4\u65B0\u4E0E\u4FEE\u6539</b>  \r\n\u6211\u4EEC\u53EF\u80FD\u968F\u65F6\u5728\u4E0D\u4E8B\u5148\u901A\u77E5\u7684\u60C5\u51B5\u4E0B\u66F4\u65B0\u6216\u4FEE\u6539\u672CApp\u53CA\u8FD9\u4E9B\u6761\u6B3E\u3002 
      \r\n\u5728\u66F4\u6539\u53D1\u5E03\u540E\u7EE7\u7EED\u4F7F\u7528\u672CApp\uFF0C\u5373\u8868\u793A\u60A8\u63A5\u53D7\u8FD9\u4E9B\u66F4\u6539\u3002 
      \r\n\u5EFA\u8BAE\u60A8\u5B9A\u671F\u67E5\u770B\u6B64\u9875\u9762\u4EE5\u83B7\u53D6\u66F4\u65B0\u3002 
      \r\n\r\n<b>8. \u8BBF\u95EE\u7EC8\u6B62</b>  \r\nMuseoAR\u4FDD\u7559\u5728\u672A\u7ECF\u901A\u77E5\u7684\u60C5\u51B5\u4E0B\uFF0C\u56E0\u4EFB\u4F55\u8FDD\u53CD\u672C\u6761\u6B3E\u7684\u884C\u4E3A\u7EC8\u6B62\u6216\u6682\u505C\u60A8\u5BF9\u672CApp\u7684\u8BBF\u95EE\u7684\u6743\u5229\u3002 
      \r\n\u7EC8\u6B62\u540E\uFF0C\u6839\u636E\u672C\u6761\u6B3E\u6388\u4E88\u60A8\u7684\u6240\u6709\u6743\u5229\u5C06\u7ACB\u5373\u5931\u6548\u3002 
      \r\n\r\n<b>9. \u9002\u7528\u6CD5\u5F8B</b>  \r\n\u672C\u6761\u6B3E\u53D7\u83F2\u5F8B\u5BBE\u6CD5\u5F8B\u7BA1\u8F96\u5E76\u4F9D\u5176\u89E3\u91CA\uFF0C\u800C\u4E0D\u8003\u8651\u5176\u6CD5\u5F8B\u51B2\u7A81\u539F\u5219\u3002 
      \r\n\r\n<b>10. \u8054\u7CFB\u4FE1\u606F</b>  \r\n\u5982\u5BF9\u672C\u6761\u6B3E\u6709\u4EFB\u4F55\u95EE\u9898\u6216\u7591\u8651\uFF0C\u8BF7\u8054\u7CFB\u6211\u4EEC\uFF1A 
      \r\n\u90AE\u7BB1: museoar2024@gmail.com  \r\n\u5730\u5740: STI Academic Center,
      Alabang-Zapote Road, corner V.Guinto, Las Pi\xF1as, 1740 Metro Manila.  \r\n\r\n<b>11.
      \u514D\u8D23\u58F0\u660E</b>  \r\n\u672CApp\u6309\u201C\u73B0\u72B6\u201D\u63D0\u4F9B\uFF0C\u4E0D\u9644\u5E26\u4EFB\u4F55\u660E\u793A\u6216\u6697\u793A\u7684\u4FDD\u8BC1\u3002 
      \r\nMuseoAR\u4E0D\u4FDD\u8BC1\u672CApp\u65E0\u9519\u8BEF\u6216\u4E0D\u4E2D\u65AD\u3002 
      \r\n\r\n<b>12. \u7528\u6237\u786E\u8BA4</b>  \r\n\u4F7F\u7528\u672CApp\u5373\u8868\u793A\u60A8\u5DF2\u9605\u8BFB\u3001\u7406\u89E3\u5E76\u540C\u610F\u53D7\u672C\u6761\u6B3E\u548C\u6761\u4EF6\u7684\u7EA6\u675F\u3002 
      \r\n\u8981\u4F7F\u7528\u8BE5App\u3002\n<b>2. \u670D\u52A1\u8BF4\u660E</b> MuseoAR\u662F\u4E00\u6B3E\u589E\u5F3A\u73B0\u5B9E\uFF08AR\uFF09\u79FB\u52A8\u5E94\u7528\u7A0B\u5E8F\uFF0C\u65E8\u5728\u901A\u8FC7\u63D0\u4F9B\u4E92\u52A8\u7684\u3001\u591A\u8BED\u8A00\u7684\u6587\u7269\u548C\u5C55\u89C8\u4FE1\u606F\u6765\u63D0\u5347\u535A\u7269\u9986\u4F53\u9A8C\u3002\u8BE5App\u4EC5\u7528\u4E8E\u4FE1\u606F\u4E0E\u6559\u80B2\u76EE\u7684\u3002\n<b>3.
      \u7528\u6237\u4E49\u52A1</b> \u60A8\u540C\u610F\u6309\u7167\u6240\u6709\u9002\u7528\u7684\u6CD5\u5F8B\u6CD5\u89C4\u4F7F\u7528\u8BE5App\u3002\u60A8\u4E0D\u5F97\u4EE5\u4EFB\u4F55\u53EF\u80FD\u635F\u5BB3\u5176\u529F\u80FD\u6216\u5F71\u54CD\u5176\u4ED6\u7528\u6237\u8BBF\u95EE\u7684\u65B9\u5F0F\u6EE5\u7528\u8BE5App\u3002\n<b>4.
      \u77E5\u8BC6\u4EA7\u6743</b> App\u5185\u7684\u6240\u6709\u5185\u5BB9\uFF0C\u5305\u62EC\u4F46\u4E0D\u9650\u4E8E\u6587\u672C\u3001\u56FE\u5F62\u3001\u56FE\u50CF\u3001\u8F6F\u4EF6\u548C\u591A\u5A92\u4F53\uFF0C\u5747\u4E3AMuseoAR\u6216\u5176\u8BB8\u53EF\u65B9\u7684\u77E5\u8BC6\u4EA7\u6743\u3002\u672A\u7ECF\u4E8B\u5148\u4E66\u9762\u8BB8\u53EF\uFF0C\u60A8\u4E0D\u5F97\u4FEE\u6539\u3001\u5206\u53D1\u3001\u590D\u5236\u6216\u5C06\u4EFB\u4F55\u5185\u5BB9\u7528\u4E8E\u5546\u4E1A\u76EE\u7684\u3002\n<b>5.
      \u9690\u79C1\u4E0E\u6570\u636E\u6536\u96C6</b> \u8BE5App\u53EF\u80FD\u4F1A\u6536\u96C6\u8BED\u8A00\u504F\u597D\u3001\u626B\u63CF\u5386\u53F2\u548C\u8BBE\u5907\u4FE1\u606F\uFF0C\u4EE5\u63D0\u5347\u7528\u6237\u4F53\u9A8C\u3002\u8BE6\u7EC6\u4FE1\u606F\u8BF7\u53C2\u9605\u6211\u4EEC\u7684\u9690\u79C1\u653F\u7B56\u3002\u6211\u4EEC\u627F\u8BFA\u4FDD\u62A4\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF0C\u5E76\u786E\u4FDD\u5176\u5F97\u5230\u8D1F\u8D23\u4EFB\u7684\u4F7F\u7528\u3002\n<b>6.
      \u8D23\u4EFB\u9650\u5236</b> MuseoAR\u53CA\u5176\u5F00\u53D1\u8005\u5BF9\u56E0\u4F7F\u7528\u6216\u65E0\u6CD5\u4F7F\u7528\u8BE5App\u800C\u5BFC\u81F4\u7684\u4EFB\u4F55\u76F4\u63A5\u3001\u95F4\u63A5\u3001\u5076\u7136\u3001\u7279\u6B8A\u6216\u540E\u7EED\u635F\u5BB3\u4E0D\u627F\u62C5\u8D23\u4EFB\u3002\u8BE5App\u53EF\u80FD\u5305\u542B\u6307\u5411\u7B2C\u4E09\u65B9\u7F51\u7AD9\u7684\u94FE\u63A5\uFF0C\u4EE5\u63D0\u4F9B\u989D\u5916\u8D44\u6E90\u3002MuseoAR\u5BF9\u8FD9\u4E9B\u5916\u90E8\u7F51\u7AD9\u7684\u5185\u5BB9\u6216\u53EF\u7528\u6027\u4E0D\u8D1F\u8D23\u4EFB\u3002\n<b>7.
      \u66F4\u65B0\u4E0E\u4FEE\u6539</b> \u6211\u4EEC\u53EF\u80FD\u968F\u65F6\u5728\u672A\u63D0\u524D\u901A\u77E5\u7684\u60C5\u51B5\u4E0B\u66F4\u65B0\u6216\u4FEE\u6539\u8BE5App\u53CA\u672C\u6761\u6B3E\u4E0E\u6761\u4EF6\u3002\u7EE7\u7EED\u4F7F\u7528\u8BE5App\u5373\u8868\u793A\u60A8\u63A5\u53D7\u8FD9\u4E9B\u53D8\u66F4\u3002\u6211\u4EEC\u5EFA\u8BAE\u60A8\u5B9A\u671F\u67E5\u770B\u6B64\u9875\u9762\u4EE5\u83B7\u53D6\u66F4\u65B0\u3002\n<b>8.
      \u8BBF\u95EE\u7EC8\u6B62</b> MuseoAR\u4FDD\u7559\u5728\u60A8\u8FDD\u53CD\u672C\u6761\u6B3E\u7684\u60C5\u51B5\u4E0B\uFF0C\u65E0\u9700\u901A\u77E5\u5373\u53EF\u7EC8\u6B62\u6216\u6682\u505C\u60A8\u5BF9\u8BE5App\u7684\u8BBF\u95EE\u7684\u6743\u5229\u3002\u7EC8\u6B62\u540E\uFF0C\u60A8\u5728\u672C\u6761\u6B3E\u4E0B\u83B7\u5F97\u7684\u6240\u6709\u6743\u5229\u5C06\u7ACB\u5373\u7EC8\u6B62\u3002\n<b>9.
      \u7BA1\u8F96\u6CD5\u5F8B</b> \u672C\u6761\u6B3E\u4E0E\u6761\u4EF6\u53D7\u83F2\u5F8B\u5BBE\u6CD5\u5F8B\u7BA1\u8F96\u5E76\u4F9D\u5176\u89E3\u91CA\uFF0C\u800C\u4E0D\u8003\u8651\u5176\u6CD5\u5F8B\u51B2\u7A81\u539F\u5219\u3002\n<b>10.
      \u8054\u7CFB\u4FE1\u606F</b> \u5982\u5BF9\u672C\u6761\u6B3E\u4E0E\u6761\u4EF6\u6709\u4EFB\u4F55\u95EE\u9898\u6216\u7591\u8651\uFF0C\u8BF7\u901A\u8FC7\u4EE5\u4E0B\u65B9\u5F0F\u8054\u7CFB\u6211\u4EEC\uFF1A\u90AE\u7BB1:
