  - m_Id: 7967420522786816
    m_Localized: "\u300A\u594E\u963F\u6CE2\u7684\u9ED1\u8272\u62FF\u6492\u52D2\u50CF\u300B\uFF08The
      Black Nazarene of Quiapo\uFF09 \u662F\u4E00\u5E45 \u6CB9\u753B\u4F5C\u54C1\uFF08oil
      on canvas\uFF09\uFF0C\u751F\u52A8\u63CF\u7ED8\u4E86\u83F2\u5F8B\u5BBE\u4EBA\u5728\u594E\u963F\u6CE2\u9ED1\u8272\u62FF\u6492\u52D2\u6E38\u884C\u4E2D\u5C55\u73B0\u51FA\u7684\u6DF1\u539A\u4FE1\u4EF0\u3001\u8654\u8BDA\u4E0E\u56E2\u7ED3\u7CBE\u795E\u3002\u8FD9\u5E45\u753B\u8868\u73B0\u4E86\u4EBA\u4EEC\u5373\u4F7F\u5728\u6DF7\u4E71\u4E4B\u4E2D\u4E5F\u5171\u540C\u7948\u7977\u7684\u573A\u666F\uFF0C\u53CD\u6620\u51FA\u83F2\u5F8B\u5BBE\u5929\u4E3B\u6559\u5F92\u6DF1\u5C42\u7684\u5B97\u6559\u7CBE\u795E\u3002\n\n\u666E\u9C81\u52A0\u5357\uFF08Puruganan\uFF09
      \u5DE7\u5999\u5730\u8FD0\u7528\u4E86\u827A\u672F\u7684\u5404\u79CD\u5143\u7D20\u4E0E\u539F\u5219\u2014\u2014\u5305\u62EC\u7EBF\u6761\u3001\u5F62\u72B6\u3001\u8272\u5F69\u3001\u660E\u6697\u3001\u8D28\u611F\u3001\u7A7A\u95F4\u4E0E\u5E73\u8861\u2014\u2014\u4F7F\u753B\u9762\u6829\u6829\u5982\u751F\u3002\u4ED6\u4F7F\u7528\u76F4\u7EBF\u4E0E\u6D41\u52A8\u7684\u7EBF\u6761\u6765\u8868\u73B0\u6559\u5802\u7684\u5EFA\u7B51\u7ED3\u6784\u548C\u4EBA\u7FA4\u8863\u670D\u7684\u52A8\u6001\uFF0C\u8FD0\u7528\u6E29\u6696\u800C\u660E\u4EAE\u7684\u8272\u8C03\u6765\u8868\u73B0\u4ECE\u6559\u5802\u7A97\u6237\u900F\u51FA\u7684\u5149\u7EBF\uFF0C\u8425\u9020\u51FA\u660E\u4EAE\u800C\u5145\u6EE1\u5E0C\u671B\u7684\u6C1B\u56F4\u3002\u7A7A\u95F4\u7684\u8FD0\u7528\u5C55\u73B0\u4E86\u5145\u6EE1\u751F\u6C14\u7684\u4EBA\u7FA4\u573A\u666F\uFF0C\u800C\u8D28\u611F\u4E0E\u56FE\u6848\u5219\u8BA9\u753B\u9762\u663E\u5F97\u67D4\u548C\u4E14\u5BCC\u6709\u52A8\u611F\u3002\n\n\u5728\u8BBE\u8BA1\u539F\u5219\u4E0A\uFF0C\u4F5C\u54C1\u7A81\u51FA\u4E86\u8EAB\u7A7F\u7EA2\u888D\u7684\u9ED1\u8272\u62FF\u6492\u52D2\u50CF\u4F5C\u4E3A\u4FE1\u4EF0\u4E0E\u727A\u7272\u7684\u8C61\u5F81\u3002\u827A\u672F\u5BB6\u901A\u8FC7\u8FD0\u52A8\u611F\u4E0E\u6BD4\u4F8B\u7684\u5904\u7406\uFF0C\u4F7F\u4EBA\u4EEC\u5728\u62AC\u4E3E\u5723\u50CF\u7684\u573A\u666F\u4E2D\u611F\u53D7\u5230\u6D41\u52A8\u7684\u529B\u91CF\u4E0E\u8654\u8BDA\u7684\u6FC0\u60C5\uFF0C\u5145\u5206\u8868\u73B0\u4E86\u4FE1\u5F92\u4EEC\u7684\u70ED\u60C5\u4E0E\u5949\u732E\u7CBE\u795E\u3002\n\n\u603B\u4F53\u800C\u8A00\uFF0C\u8FD9\u5E45\u753B\u5DE7\u5999\u5730\u878D\u5408\u4E86\u6280\u5DE7\u4E0E\u60C5\u611F\uFF0C\u5C55\u73B0\u4E86\u83F2\u5F8B\u5BBE\u4EBA\u6C11\u5728\u9ED1\u8272\u62FF\u6492\u52D2\u4FE1\u4EF0\u4E2D\u7684\u575A\u97E7\u3001\u56E2\u7ED3\u4E0E\u4E0D\u52A8\u6447\u7684\u4FE1\u5FF5"
    m_Metadata:
      m_Items: []
