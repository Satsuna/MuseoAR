  - m_Id: 7967420522786816
    m_Localized: "\u300C\u30AD\u30A2\u30DD\u306E\u30D6\u30E9\u30C3\u30AF\u30FB\u30CA\u30B6\u30EC\u50CF\uFF08The
      Black Nazarene of Quiapo\uFF09\u300D \u306F\u3001\u6CB9\u5F69\u753B\uFF08\u30AA\u30A4\u30EB\u30FB\u30AA\u30F3\u30FB\u30AD\u30E3\u30F3\u30D0\u30B9\uFF09
      \u3067\u63CF\u304B\u308C\u305F\u4F5C\u54C1\u3067\u3042\u308A\u3001\u30AD\u30A2\u30DD\u3067\u884C\u308F\u308C\u308B\u30D6\u30E9\u30C3\u30AF\u30FB\u30CA\u30B6\u30EC\u884C\u5217\u306E\u969B\u306E\u30D5\u30A3\u30EA\u30D4\u30F3\u4EBA\u306E\u6DF1\u3044\u4FE1\u4EF0\u3001\u732E\u8EAB\u3001\u305D\u3057\u3066\u56E3\u7D50\u3092\u898B\u4E8B\u306B\u8868\u73FE\u3057\u3066\u3044\u307E\u3059\u3002\u3053\u306E\u4F5C\u54C1\u306F\u3001\u6DF7\u4E71\u306E\u4E2D\u3067\u3082\u7948\u308A\u306E\u305F\u3081\u306B\u4EBA\u3005\u304C\u4E00\u3064\u306B\u306A\u308B\u59FF\u3092\u63CF\u304D\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u306E\u30AB\u30C8\u30EA\u30C3\u30AF\u4FE1\u4EF0\u306E\u6DF1\u3044\u7CBE\u795E\u6027\u3092\u6620\u3057\u51FA\u3057\u3066\u3044\u307E\u3059\u3002\n\n\u30D7\u30EB\u30AC\u30CA\u30F3\uFF08Puruganan\uFF09
      \u306F\u3001\u4F5C\u54C1\u3092\u751F\u304D\u751F\u304D\u3068\u8868\u73FE\u3059\u308B\u305F\u3081\u306B\u3001\u7DDA\u3001\u5F62\u3001\u8272\u3001\u660E\u6697\u3001\u8CEA\u611F\u3001\u7A7A\u9593\u3001\u305D\u3057\u3066\u30D0\u30E9\u30F3\u30B9\u3068\u3044\u3063\u305F\u3055\u307E\u3056\u307E\u306A\u7F8E\u8853\u306E\u8981\u7D20\u3068\u539F\u5247\u3092\u5DE7\u307F\u306B\u7528\u3044\u307E\u3057\u305F\u3002\u76F4\u7DDA\u3084\u6D41\u308C\u308B\u3088\u3046\u306A\u7DDA\u3067\u6559\u4F1A\u306E\u5EFA\u7BC9\u3084\u4EBA\u3005\u306E\u8863\u670D\u306E\u52D5\u304D\u3092\u63CF\u304D\u3001\u6696\u304B\u304F\u660E\u308B\u3044\u8272\u8ABF\u3067\u6559\u4F1A\u306E\u7A93\u304B\u3089\u5DEE\u3057\u8FBC\u3080\u5149\u3092\u8868\u73FE\u3057\u3001\u660E\u308B\u304F\u5E0C\u671B\u306B\u6E80\u3061\u305F\u96F0\u56F2\u6C17\u3092\u4F5C\u308A\u51FA\u3057\u3066\u3044\u307E\u3059\u3002\u7A7A\u9593\u306E\u4F7F\u3044\u65B9\u306F\u4EBA\u3005\u3067\u6EA2\u308C\u308B\u6D3B\u6C17\u3042\u308B\u5834\u9762\u3092\u793A\u3057\u3001\u8CEA\u611F\u3068\u6A21\u69D8\u304C\u7D75\u5168\u4F53\u306B\u67D4\u3089\u304B\u3055\u3068\u52D5\u304D\u3092\u4E0E\u3048\u3066\u3044\u307E\u3059\u3002\n\n\u30C7\u30B6\u30A4\u30F3\u306E\u539F\u5247\u306B\u304A\u3044\u3066\u306F\u3001\u8D64\u3044\u8863\u3092\u307E\u3068\u3063\u305F\u30D6\u30E9\u30C3\u30AF\u30FB\u30CA\u30B6\u30EC\u50CF\u304C\u4FE1\u4EF0\u3068\u72A0\u7272\u306E\u8C61\u5FB4\u3068\u3057\u3066\u4E2D\u5FC3\u306B\u5F37\u8ABF\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u753B\u5BB6\u306F\u52D5\u304D\u3068\u6BD4\u4F8B\u3092\u5DE7\u307F\u306B\u4F7F\u3044\u3001\u4FE1\u8005\u305F\u3061\u304C\u50CF\u3092\u62C5\u3050\u751F\u304D\u305F\u8E8D\u52D5\u611F\u3092\u751F\u307F\u51FA\u3057\u3001\u5F7C\u3089\u306E\u60C5\u71B1\u3068\u4FE1\u5FC3\u3092\u969B\u7ACB\u305F\u305B\u3066\u3044\u307E\u3059\u3002\n\n\u5168\u4F53\u3068\u3057\u3066\u3001\u3053\u306E\u7D75\u753B\u306F\u6280\u6CD5\u3068\u611F\u60C5\u304C\u7F8E\u3057\u304F\u878D\u5408\u3057\u305F\u4F5C\u54C1\u3067\u3042\u308A\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u4EBA\u306E\u5F37\u976D\u3055\u3001\u56E3\u7D50\u5FC3\u3001\u305D\u3057\u3066\u63FA\u308B\u304E\u306A\u3044\u4FE1\u4EF0\u3092\u30D6\u30E9\u30C3\u30AF\u30FB\u30CA\u30B6\u30EC\u50CF\u3092\u901A\u3057\u3066\u529B\u5F37\u304F\u8868\u73FE\u3057\u3066\u3044\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
