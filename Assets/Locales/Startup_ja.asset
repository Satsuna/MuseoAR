  - m_Id: 7931272299638784
    m_Localized: "\"\u30A8\u30DF\u30EA\u30AA\u30FB\u300C\u30A2\u30D9\u300D\u30FB\u30A2\u30AE\u30E9\u30EB\u30FB\u30AF\u30EB\u30B9\u306F\u30011915\u5E74\u306B\u30D1\u30F3\u30D1\u30F3\u30AC\u5DDE\u30DE\u30AC\u30E9\u30F3\u3067\u751F\u307E\u308C\u305F\u30D5\u30A3\u30EA\u30D4\u30F3\u306E\u82B8\u8853\u5BB6\u3001\u4F5C\u5BB6\u3001\u305D\u3057\u3066\u5916\u4EA4\u5B98\u3067\u3059\u3002\u30DE\u30CB\u30E9\u3067\u7D75\u753B\u3092\u5B66\u3073\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u5370\u8C61\u6D3E\u306E\u4E3B\u8981\u4EBA\u7269\u306E\u4E00\u4EBA\u3068\u3057\u3066\u3001\u300C\u30C7\u30A3\u30DE\u30B5\u30E9\u30F3\u300D\u3084\u300C\u30B5\u30BF\u30C7\u30FC\u30FB\u30B0\u30EB\u30FC\u30D7\u300D\u3068\u3044\u3063\u305F\u56E3\u4F53\u3092\u7387\u3044\u307E\u3057\u305F\u3002\u5F7C\u306E\u4F5C\u54C1\u306F\u3057\u3070\u3057\u3070\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u306E\u751F\u6D3B\u3001\u6587\u5316\u3001\u305D\u3057\u3066\u500B\u4EBA\u7684\u306A\u601D\u3044\u51FA\u3092\u8868\u73FE\u3057\u3066\u3044\u307E\u3059\u3002\n\n\u5F7C\u306E\u7D75\u753B\u300C\u30AB\u30D5\u30A7\u30FB\u30B7\u30FC\u30F32\u300D\u306F\u3001\u30B3\u30FC\u30D2\u30FC\u3092\u98F2\u307F\u306A\u304C\u3089\u8A9E\u308A\u5408\u3044\u3001\u5171\u306B\u904E\u3054\u3059\u3068\u3044\u3046\u30D5\u30A3\u30EA\u30D4\u30F3\u4EBA\u306E\u5178\u578B\u7684\u306A\u7FD2\u6163\u3092\u63CF\u3044\u3066\u3044\u307E\u3059\u3002\u3053\u308C\u306F\u3001\u30B3\u30FC\u30D2\u30FC\u3092\u6301\u3063\u3066\u79FB\u52D5\u3059\u308B\u30A2\u30E1\u30EA\u30AB\u4EBA\u306E\u30B9\u30BF\u30A4\u30EB\u3068\u306F\u5BFE\u7167\u7684\u3067\u3059\u3002\u3053\u306E\u4F5C\u54C1\u306F\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u6587\u5316\u306E\u6E29\u304B\u3055\u3068\u793E\u4EA4\u7684\u306A\u6027\u8CEA\u3092\u3068\u3089\u3048\u3066\u3044\u307E\u3059\u3002
      \u3053\u306E\u8096\u50CF\u753B\u304A\u3088\u3073\u5C55\u793A\u3055\u308C\u3066\u3044\u308B\u4ED6\u306E\u4F5C\u54C1\u304B\u3089\u3082\u308F\u304B\u308B\u3088\u3046\u306B\u3001\u30AF\u30EB\u30B9\u6C0F\u306E\u4F5C\u54C1\u306E\u3044\u304F\u3064\u304B\u306F\u975E\u5E38\u306B\u500B\u4EBA\u7684\u3067\u3001\u5F7C\u81EA\u8EAB\u306E\u8A18\u61B6\u3068\u6DF1\u304F\u7D50\u3073\u3064\u3044\u3066\u304A\u308A\u3001\u305D\u306E\u82B8\u8853\u7684\u306A\u904E\u7A0B\u3068\u5353\u8D8A\u6027\u3092\u793A\u3059\u8CB4\u91CD\u3067\u91CD\u8981\u306A\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u3068\u306A\u3063\u3066\u3044\u307E\u3059\u3002\""
    m_Metadata:
      m_Items: []
  - m_Id: 7932526639804416
    m_Localized: "\"\u30D1\u30D6\u30ED\u30FB\u30A2\u30E2\u30EB\u30BD\u30ED\u30FB\u30A4\u30FB\u30AF\u30A8\u30C8\uFF08Pablo
      Amorsolo y Cueto\uFF09\u306E\u4F5C\u54C1 \u300C\u30E1\u30B9\u30C6\u30A3\u30FC\u30B5\uFF08Mestiza\uFF09\u300D
      \u306F\u3001\u5CF6\u3092\u898B\u3064\u3081\u308B\u4E00\u4EBA\u306E\u5973\u6027\u3092\u63CF\u3044\u3066\u3044\u307E\u3059\u3002\u5F7C\u5973\u306F\u307E\u308B\u3067\u904E\u53BB\u306E\u601D\u3044\u51FA\u306B\u6D78\u3063\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u3067\u3001\u305D\u306E\u904E\u53BB\u306B\u306F\u75DB\u307F\u3068\u6210\u9577\u304C\u3042\u308A\u3001\u305D\u308C\u304C\u5F7C\u5973\u3068\u3044\u3046\u4EBA\u9593\u3092\u5F62\u4F5C\u3063\u3066\u304D\u307E\u3057\u305F\u3002\n\u753B\u5BB6\u306F\u5F7C\u5973\u306E**\u6DF7\u8840\u306E\u80CC\u666F\uFF08\u30E1\u30B9\u30C6\u30A3\u30FC\u30B5\uFF09**\u3092\u5F37\u8ABF\u3059\u308B\u3053\u3068\u3067\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u306E\u690D\u6C11\u5730\u6642\u4EE3\u306E\u6B74\u53F2\u3092\u8C61\u5FB4\u7684\u306B\u8868\u73FE\u3057\u3066\u3044\u308B\u306E\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\n\n\u5F7C\u5973\u306E\u767D\u3044\u4E0A\u7740\u306F\u7D14\u7C8B\u3055\u3068\u518D\u751F\u3092\u3001\u8D64\u3044\u30B9\u30AB\u30FC\u30C8\u306F\u529B\u5F37\u3055\u3068\u52C7\u6C17\u3092\u8C61\u5FB4\u3057\u3066\u3044\u307E\u3059\u3002\u4E18\u306F\u3001\u5F7C\u5973\u304C\u56F0\u96E3\u3092\u4E57\u308A\u8D8A\u3048\u308B\u5F37\u3055\u3068\u5FCD\u8010\u3092\u8868\u3057\u3001\u6728\u306F\u5F7C\u5973\u306E\u5B89\u5B9A\u3068\u4EBA\u751F\u3078\u306E\u78BA\u56FA\u305F\u308B\u59FF\u52E2\u3092\u793A\u3057\u3066\u3044\u307E\u3059\u3002\u307E\u305F\u3001\u53E4\u3044\u30DC\u30FC\u30C8\u306F\u3001\u5F7C\u5973\u304C\u904E\u53BB\u3092\u624B\u653E\u3057\u3001\u524D\u3078\u9032\u3080\u6C7A\u610F\u3092\u8C61\u5FB4\u3057\u3066\u3044\u307E\u3059\u3002\n\n\u5168\u4F53\u3068\u3057\u3066\u3001\u3053\u306E\u4F5C\u54C1\u306F\u5E0C\u671B\u3001\u52C7\u6C17\u3001\u305D\u3057\u3066\u5909\u5316\u3092\u8868\u73FE\u3057\u3066\u304A\u308A\u3001\u7D4C\u9A13\u3092\u901A\u3057\u3066\u3088\u308A\u5F37\u304F\u3001\u8CE2\u304F\u306A\u3063\u305F\u5973\u6027\u306E\u59FF\u3092\u63CF\u304D\u51FA\u3057\u3066\u3044\u307E\u3059\""
    m_Metadata:
