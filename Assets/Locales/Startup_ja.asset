  - m_Id: 217389329903616
    m_Localized: "\u5229\u7528\u898F\u7D04\u3092"
    m_Metadata:
      m_Items: []
  - m_Id: 217425438666752
    m_Localized: "\u8AAD\u307F\u307E\u3057\u305F"
    m_Metadata:
      m_Items: []
  - m_Id: 218534311981056
    m_Localized: "<b>1. \u5229\u7528\u898F\u7D04\u306E\u627F\u8AFE</b>  \r\nMuseoAR\u30E2\u30D0\u30A4\u30EB\u30A2\u30D7\u30EA\u30B1\u30FC\u30B7\u30E7\u30F3\uFF08\u4EE5\u4E0B\u300CApp\u300D\uFF09\u3092\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u3001\u30A2\u30AF\u30BB\u30B9\u3001\u307E\u305F\u306F\u4F7F\u7528\u3059\u308B\u3053\u3068\u306B\u3088\u308A\u3001\u3042\u306A\u305F\u306F\u672C\u5229\u7528\u898F\u7D04\u306B\u62D8\u675F\u3055\u308C\u308B\u3053\u3068\u306B\u540C\u610F\u3057\u307E\u3059\u3002 
      \r\n\u540C\u610F\u3055\u308C\u306A\u3044\u5834\u5408\u306F\u3001App\u3092\u4F7F\u7528\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002 
      \r\n\r\n<b>2. \u30B5\u30FC\u30D3\u30B9\u306E\u8AAC\u660E</b>  \r\nMuseoAR\u306F\u62E1\u5F35\u73FE\u5B9F\uFF08AR\uFF09\u30E2\u30D0\u30A4\u30EB\u30A2\u30D7\u30EA\u30B1\u30FC\u30B7\u30E7\u30F3\u3067\u3042\u308A\u3001\u907A\u7269\u3084\u5C55\u793A\u54C1\u306B\u95A2\u3059\u308B\u30A4\u30F3\u30BF\u30E9\u30AF\u30C6\u30A3\u30D6\u3067\u591A\u8A00\u8A9E\u306E\u60C5\u5831\u3092\u63D0\u4F9B\u3059\u308B\u3053\u3068\u3067\u3001\u535A\u7269\u9928\u3067\u306E\u4F53\u9A13\u3092\u5411\u4E0A\u3055\u305B\u308B\u3088\u3046\u8A2D\u8A08\u3055\u308C\u3066\u3044\u307E\u3059\u3002 
      \r\n\u3053\u306EApp\u306F\u60C5\u5831\u63D0\u4F9B\u304A\u3088\u3073\u6559\u80B2\u76EE\u7684\u306E\u307F\u306B\u4F7F\u7528\u3055\u308C\u307E\u3059\u3002 
      \r\n\r\n<b>3. \u30E6\u30FC\u30B6\u30FC\u306E\u7FA9\u52D9</b>  \r\n\u3042\u306A\u305F\u306F\u3001\u3059\u3079\u3066\u306E\u9069\u7528\u3055\u308C\u308B\u6CD5\u5F8B\u304A\u3088\u3073\u898F\u5247\u306B\u5F93\u3063\u3066App\u3092\u4F7F\u7528\u3059\u308B\u3053\u3068\u306B\u540C\u610F\u3057\u307E\u3059\u3002 
      \r\n\u4ED6\u306E\u30E6\u30FC\u30B6\u30FC\u306E\u6A5F\u80FD\u3084\u30A2\u30AF\u30BB\u30B9\u6A29\u3092\u640D\u306A\u3046\u53EF\u80FD\u6027\u306E\u3042\u308B\u65B9\u6CD5\u3067App\u3092\u4E0D\u6B63\u306B\u4F7F\u7528\u3057\u3066\u306F\u3044\u3051\u307E\u305B\u3093\u3002 
      \r\n\r\n<b>4. \u77E5\u7684\u8CA1\u7523\u6A29</b>  \r\n\u30C6\u30AD\u30B9\u30C8\u3001\u30B0\u30E9\u30D5\u30A3\u30C3\u30AF\u3001\u753B\u50CF\u3001\u30BD\u30D5\u30C8\u30A6\u30A7\u30A2\u3001\u30DE\u30EB\u30C1\u30E1\u30C7\u30A3\u30A2\u306A\u3069\u3092\u542B\u3080App\u5185\u306E\u3059\u3079\u3066\u306E\u30B3\u30F3\u30C6\u30F3\u30C4\u306F\u3001MuseoAR\u307E\u305F\u306F\u305D\u306E\u30E9\u30A4\u30BB\u30F3\u30B5\u30FC\u306E\u77E5\u7684\u8CA1\u7523\u3067\u3059\u3002 
      \r\n\u4E8B\u524D\u306E\u66F8\u9762\u306B\u3088\u308B\u540C\u610F\u306A\u3057\u306B\u3001\u30B3\u30F3\u30C6\u30F3\u30C4\u3092\u6539\u5909\u3001\u914D\u5E03\u3001\u8907\u88FD\u3001\u307E\u305F\u306F\u5546\u696D\u76EE\u7684\u3067\u4F7F\u7528\u3059\u308B\u3053\u3068\u306F\u8A31\u53EF\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002 
      \r\n\r\n<b>5. \u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u3068\u30C7\u30FC\u30BF\u53CE\u96C6</b> 
      \r\nApp\u306F\u3001\u8A00\u8A9E\u8A2D\u5B9A\u3001\u30B9\u30AD\u30E3\u30F3\u5C65\u6B74\u3001\u30C7\u30D0\u30A4\u30B9\u60C5\u5831\u306A\u3069\u306E\u30C7\u30FC\u30BF\u3092\u53CE\u96C6\u3057\u3001\u30E6\u30FC\u30B6\u30FC\u4F53\u9A13\u3092\u5411\u4E0A\u3055\u305B\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002 
      \r\n\u8A73\u7D30\u306B\u3064\u3044\u3066\u306F\u3001\u5F53\u793E\u306E\u30D7\u30E9\u30A4\u30D0\u30B7\u30FC\u30DD\u30EA\u30B7\u30FC\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002 
      \r\n\u5F53\u793E\u306F\u3001\u3042\u306A\u305F\u306E\u500B\u4EBA\u60C5\u5831\u3092\u4FDD\u8B77\u3057\u3001\u8CAC\u4EFB\u3092\u6301\u3063\u3066\u4F7F\u7528\u3055\u308C\u308B\u3053\u3068\u3092\u4FDD\u8A3C\u3057\u307E\u3059\u3002 
      \r\n\r\n<b>6. \u8CAC\u4EFB\u306E\u5236\u9650</b>  \r\nMuseoAR\u304A\u3088\u3073\u305D\u306E\u958B\u767A\u8005\u306F\u3001App\u306E\u4F7F\u7528\u307E\u305F\u306F\u4F7F\u7528\u4E0D\u80FD\u304B\u3089\u751F\u3058\u308B\u76F4\u63A5\u7684\u3001\u9593\u63A5\u7684\u3001\u4ED8\u968F\u7684\u3001\u7279\u5225\u3001\u307E\u305F\u306F\u7D50\u679C\u7684\u640D\u5BB3\u306B\u3064\u3044\u3066\u4E00\u5207\u306E\u8CAC\u4EFB\u3092\u8CA0\u3044\u307E\u305B\u3093\u3002 
      \r\nApp\u306B\u306F\u8FFD\u52A0\u306E\u30EA\u30BD\u30FC\u30B9\u3092\u63D0\u4F9B\u3059\u308B\u305F\u3081\u306E\u7B2C\u4E09\u8005\u30A6\u30A7\u30D6\u30B5\u30A4\u30C8\u3078\u306E\u30EA\u30F3\u30AF\u304C\u542B\u307E\u308C\u308B\u5834\u5408\u304C\u3042\u308A\u307E\u3059\u3002 
      \r\nMuseoAR\u306F\u3001\u3053\u308C\u3089\u5916\u90E8\u30B5\u30A4\u30C8\u306E\u5185\u5BB9\u3084\u5229\u7528\u53EF\u80FD\u6027\u306B\u3064\u3044\u3066\u8CAC\u4EFB\u3092\u8CA0\u3044\u307E\u305B\u3093\u3002 
      \r\n\r\n<b>7. \u66F4\u65B0\u3068\u4FEE\u6B63</b>  \r\n\u5F53\u793E\u306F\u3001\u4E8B\u524D\u306E\u901A\u77E5\u306A\u3057\u306B\u3044\u3064\u3067\u3082App\u304A\u3088\u3073\u672C\u5229\u7528\u898F\u7D04\u3092\u66F4\u65B0\u307E\u305F\u306F\u4FEE\u6B63\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002 
      \r\n\u5909\u66F4\u304C\u516C\u958B\u3055\u308C\u305F\u5F8C\u306BApp\u3092\u5F15\u304D\u7D9A\u304D\u4F7F\u7528\u3059\u308B\u3053\u3068\u3067\u3001\u3042\u306A\u305F\u306F\u305D\u306E\u5909\u66F4\u3092\u53D7\u3051\u5165\u308C\u305F\u3082\u306E\u3068\u307F\u306A\u3055\u308C\u307E\u3059\u3002 
      \r\n\u5B9A\u671F\u7684\u306B\u3053\u306E\u30DA\u30FC\u30B8\u3092\u78BA\u8A8D\u3059\u308B\u3053\u3068\u3092\u304A\u52E7\u3081\u3057\u307E\u3059\u3002 
      \r\n\r\n<b>8. \u30A2\u30AF\u30BB\u30B9\u306E\u7D42\u4E86</b>  \r\nMuseoAR\u306F\u3001\u672C\u898F\u7D04\u306E\u9055\u53CD\u306B\u5BFE\u3057\u3066\u3001\u4E8B\u524D\u901A\u77E5\u306A\u3057\u306B\u3042\u306A\u305F\u306EApp\u3078\u306E\u30A2\u30AF\u30BB\u30B9\u3092\u7D42\u4E86\u307E\u305F\u306F\u505C\u6B62\u3059\u308B\u6A29\u5229\u3092\u7559\u4FDD\u3057\u307E\u3059\u3002 
      \r\n\u7D42\u4E86\u6642\u70B9\u3067\u3001\u672C\u898F\u7D04\u306B\u57FA\u3065\u304D\u3042\u306A\u305F\u306B\u4ED8\u4E0E\u3055\u308C\u305F\u3059\u3079\u3066\u306E\u6A29\u5229\u306F\u76F4\u3061\u306B\u5931\u52B9\u3057\u307E\u3059\u3002 
      \r\n\r\n<b>9. \u6E96\u62E0\u6CD5</b>  \r\n\u672C\u898F\u7D04\u306F\u3001\u30D5\u30A3\u30EA\u30D4\u30F3\u306E\u6CD5\u5F8B\u306B\u5F93\u3063\u3066\u898F\u5B9A\u304A\u3088\u3073\u89E3\u91C8\u3055\u308C\u307E\u3059\u3002 
      \r\n\u6CD5\u306E\u62B5\u89E6\u306B\u95A2\u3059\u308B\u539F\u5247\u306F\u9069\u7528\u3055\u308C\u307E\u305B\u3093\u3002 
      \r\n\r\n<b>10. \u9023\u7D61\u5148\u60C5\u5831</b>  \r\n\u672C\u898F\u7D04\u306B\u95A2\u3057\u3066\u8CEA\u554F\u3084\u61F8\u5FF5\u304C\u3042\u308B\u5834\u5408\u306F\u3001\u4EE5\u4E0B\u307E\u3067\u3054\u9023\u7D61\u304F\u3060\u3055\u3044: 
      \r\nEmail: museoar2024@gmail.com  \r\n\u4F4F\u6240: STI Academic Center, Alabang-Zapote
      Road, corner V.Guinto, Las Pi\xF1as, 1740 Metro Manila.  \r\n\r\n<b>11. \u514D\u8CAC\u4E8B\u9805</b> 
      \r\n\u672CApp\u306F\u3001\u660E\u793A\u307E\u305F\u306F\u9ED9\u793A\u3092\u554F\u308F\u305A\u3001\u3044\u304B\u306A\u308B\u4FDD\u8A3C\u3082\u306A\u304F\u300C\u73FE\u72B6\u306E\u307E\u307E\u300D\u3067\u63D0\u4F9B\u3055\u308C\u307E\u3059\u3002 
      \r\nMuseoAR\u306F\u3001App\u304C\u30A8\u30E9\u30FC\u306A\u304F\u307E\u305F\u306F\u4E2D\u65AD\u306A\u304F\u52D5\u4F5C\u3059\u308B\u3053\u3068\u3092\u4FDD\u8A3C\u3057\u307E\u305B\u3093\u3002 
      \r\n\r\n<b>12. \u30E6\u30FC\u30B6\u30FC\u306E\u78BA\u8A8D</b>  \r\nApp\u3092\u4F7F\u7528\u3059\u308B\u3053\u3068\u3067\u3001\u3042\u306A\u305F\u306F\u672C\u898F\u7D04\u3092\u8AAD\u307F\u3001\u7406\u89E3\u3057\u3001\u305D\u306E\u62D8\u675F\u3092\u53D7\u3051\u308B\u3053\u3068\u306B\u540C\u610F\u3057\u305F\u3053\u3068\u3092\u8A8D\u3081\u307E\u3059\u3002 
      \r\n"
