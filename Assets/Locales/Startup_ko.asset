  - m_Id: 7614510962143232
    m_Localized: "\uC571 \uB370\uC774\uD130 \uC0AD\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 7616923139928064
    m_Localized: "\uC571 \uB370\uC774\uD130\uB97C \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 7840939494699008
    m_Localized: "\uC544\uBB34 \uACF3\uC774\uB098 \uD074\uB9AD\uD558\uBA74 \uB2EB\uD799\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7931272299638784
    m_Localized: "\"\uC5D0\uBC00\uB9AC\uC624 \u201C\uC544\uBCA0\u201D \uC544\uAE38\uB77C\uB974
      \uD06C\uB8E8\uC988\uB294 1915\uB144 \uD31C\uD321\uAC00\uC8FC \uB9C8\uAC08\uB791\uC5D0\uC11C
      \uD0DC\uC5B4\uB09C \uD544\uB9AC\uD540\uC758 \uD654\uAC00, \uC791\uAC00, \uADF8\uB9AC\uACE0
      \uC678\uAD50\uAD00\uC785\uB2C8\uB2E4. \uADF8\uB294 \uB9C8\uB2D0\uB77C\uC5D0\uC11C
      \uD68C\uD654\uB97C \uACF5\uBD80\uD588\uC73C\uBA70, \uD544\uB9AC\uD540 \uC778\uC0C1\uC8FC\uC758\uC758
      \uC8FC\uC694 \uC778\uBB3C \uC911 \uD55C \uBA85\uC73C\uB85C\uC11C \uB514\uB9C8\uC0B4\uB791(Dimasalang)
      \uBC0F \uC0C8\uD130\uB370\uC774 \uADF8\uB8F9(Saturday Group) \uB4F1\uC758 \uB2E8\uCCB4\uB97C
      \uC774\uB04C\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uC758 \uC791\uD488\uB4E4\uC740
      \uC885\uC885 \uD544\uB9AC\uD540\uC758 \uC0B6, \uBB38\uD654, \uADF8\uB9AC\uACE0
      \uAC1C\uC778\uC801\uC778 \uAE30\uC5B5\uC744 \uBC18\uC601\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uC758
      \uC791\uD488 \u3008\uCE74\uD398 \uC2E0 2\u3009(Cafe Scene 2) \uB294 \uCEE4\uD53C\uB97C
      \uB9C8\uC2DC\uBA70 \uB300\uD654\uD558\uACE0 \uD568\uAED8 \uC2DC\uAC04\uC744
      \uBCF4\uB0B4\uB294 \uD544\uB9AC\uD540 \uC0AC\uB78C\uB4E4\uC758 \uC804\uD615\uC801\uC778
      \uC2B5\uAD00\uC744 \uBB18\uC0AC\uD569\uB2C8\uB2E4. \uC774\uB294 \uCEE4\uD53C\uB97C
      \uB4E4\uACE0 \uC774\uB3D9\uD558\uBA70 \uB9C8\uC2DC\uB294 \uBBF8\uAD6D\uC778\uB4E4\uC758
      \uBC29\uC2DD\uACFC\uB294 \uB300\uC870\uC801\uC785\uB2C8\uB2E4. \uC774 \uC791\uD488\uC740
      \uD544\uB9AC\uD540 \uBB38\uD654\uC758 \uB530\uB73B\uD568\uACFC \uC0AC\uAD50\uC801\uC778
      \uD2B9\uC131\uC744 \uD3EC\uCC29\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC774
      \uCD08\uC0C1\uD654\uC640 \uC804\uC2DC\uB41C \uB2E4\uB978 \uC791\uD488\uB4E4\uC744
      \uD1B5\uD574 \uC54C \uC218 \uC788\uB4EF\uC774, \uD06C\uB8E8\uC988\uC758 \uC77C\uBD80
      \uC791\uD488\uC740 \uB9E4\uC6B0 \uAC1C\uC778\uC801\uC774\uBA70 \uADF8\uC758
      \uAE30\uC5B5\uACFC \uAE4A\uC774 \uC5F0\uACB0\uB418\uC5B4 \uC788\uC5B4, \uADF8\uC758
      \uC608\uC220\uC801 \uACFC\uC815\uACFC \uB6F0\uC5B4\uB09C \uC5ED\uB7C9\uC744
      \uBCF4\uC5EC\uC8FC\uB294 \uADC0\uC911\uD558\uACE0 \uC758\uBBF8 \uC788\uB294
      \uCEEC\uB809\uC158\uC774\uB77C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 7932526639804416
    m_Localized: "\"\uD30C\uBE14\uB85C \uC544\uBAA8\uB974\uC194\uB85C \uC774 \uCFE0\uC5D0\uD1A0(Pablo
      Amorsolo y Cueto)\uC758 \uC791\uD488 \u3008\uBA54\uC2A4\uD2F0\uC0AC(Mestiza)\u3009
      \uB294 \uC12C\uC744 \uBC14\uB77C\uBCF4\uB294 \uD55C \uC5EC\uC131\uC744 \uC911\uC2EC\uC73C\uB85C
      \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB140\uB294 \uB9C8\uCE58 \uACFC\uAC70\uC758
      \uAE30\uC5B5\uC5D0 \uC7A0\uAE34 \uB4EF\uD55C \uBAA8\uC2B5\uC744 \uD558\uACE0
      \uC788\uC73C\uBA70, \uADF8 \uAE30\uC5B5\uC740 \uACE0\uD1B5\uACFC \uC131\uC7A5\uC73C\uB85C
      \uAC00\uB4DD \uCC28 \uC788\uC5B4 \uC9C0\uAE08\uC758 \uADF8\uB140\uB97C \uB9CC\uB4E4\uC5B4\uB0B8
      \uAC83\uC785\uB2C8\uB2E4.\n\uD654\uAC00\uB294 \uADF8\uB140\uC758 \uD63C\uD608
      \uBC30\uACBD(\uBA54\uC2A4\uD2F0\uC0AC) \uC744 \uAC15\uC870\uD568\uC73C\uB85C\uC368,
      \uD544\uB9AC\uD540\uC758 \uC2DD\uBBFC\uC9C0 \uC5ED\uC0AC\uB97C \uC0C1\uC9D5\uC801\uC73C\uB85C
      \uD45C\uD604\uD558\uACE0\uC790 \uD588\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4.\n\n\uADF8\uB140\uC758
      \uD770\uC0C9 \uC0C1\uC758\uB294 \uC21C\uC218\uD568\uACFC \uC7AC\uD0C4\uC0DD\uC744,
      \uBD89\uC740 \uCE58\uB9C8\uB294 \uAC15\uC778\uD568\uACFC \uC6A9\uAE30\uB97C
      \uC0C1\uC9D5\uD569\uB2C8\uB2E4. \uC5B8\uB355\uC740 \uADF8\uB140\uAC00 \uC5B4\uB824\uC6C0\uC744
      \uADF9\uBCF5\uD558\uB294 \uAC15\uC778\uD55C \uC758\uC9C0\uB97C, \uB098\uBB34\uB294
      \uADF8\uB140\uC758 \uC548\uC815\uC131\uACFC \uC0B6\uC5D0 \uB300\uD55C \uD655\uACE0\uD55C
      \uC790\uC138\uB97C \uB098\uD0C0\uB0C5\uB2C8\uB2E4. \uB610\uD55C \uC624\uB798\uB41C
      \uBC30\uB294 \uADF8\uB140\uAC00 \uACFC\uAC70\uB97C \uB4A4\uB85C\uD558\uACE0
      \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uB824\uB294 \uACB0\uC2EC\uC744 \uC758\uBBF8\uD569\uB2C8\uB2E4.\n\n\uC804\uCCB4\uC801\uC73C\uB85C
      \uC774 \uC791\uD488\uC740 \uD76C\uB9DD, \uC6A9\uAE30, \uADF8\uB9AC\uACE0 \uBCC0\uD654\uB97C
      \uD45C\uD604\uD558\uBA70, \uACBD\uD5D8\uC744 \uD1B5\uD574 \uB354\uC6B1 \uAC15\uD558\uACE0
      \uC9C0\uD61C\uB85C\uC6CC\uC9C4 \uC5EC\uC131\uC758 \uBAA8\uC2B5\uC744 \uBCF4\uC5EC\uC90D\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 7932638678052864
    m_Localized: "\uCE74\uD398\uC758 \uC21C\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 7932716788576256
    m_Localized: "\uAC15\uC778\uD55C \uD63C\uD608 \uC5EC\uC778"
