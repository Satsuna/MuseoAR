  - m_Id: 608902979350528
    m_Localized: "\uC81C\uCD9C"
    m_Metadata:
      m_Items: []
  - m_Id: 610190500655104
    m_Localized: "\uC2A4\uD3F4\uB9AC\uC544\uB9AC\uC6C0\uC740 \uD544\uB9AC\uD540\uC5D0\uC11C
      \uD6C4\uC548 \uB8E8\uB098\uAC00 \uB0A8\uAE34 \uAC00\uC7A5 \uAC70\uB300\uD55C
      \uC791\uD488\uC785\uB2C8\uB2E4. \uC774 \uAE30\uB150\uBE44\uC801\uC778 \uC791\uD488\uC740
      1884\uB144 \uB9C8\uB4DC\uB9AC\uB4DC \uBBF8\uC220 \uBC15\uB78C\uD68C\uC5D0\uC11C
      \uAE08\uBA54\uB2EC\uC744 \uC218\uC0C1\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 610308696141824
    m_Localized: "\uC774 \uADF8\uB9BC\uC740 \uC5D0\uC2A4\uD30C\uB0D0 \uC2DD\uBBFC\uC9C0
      \uC2DC\uB300 \uB9C8\uB2D0\uB77C\uC5D0\uC11C \uC77C\uC5B4\uB09C \uD398\uB974\uB09C\uB3C4
      \uBD80\uC2A4\uD0C0\uB9CC\uD14C\uC640 \uC2A4\uD398\uC778 \uC218\uB3C4\uC0AC\uB4E4\uC774
      \uAD00\uB828\uB41C \uD3ED\uB825\uC801\uC774\uACE0 \uC5ED\uC0AC\uC801\uC778
      \uC0AC\uAC74\uC744 \uC774\uB2EC\uACE0\uAC00 \uD574\uC11D\uD55C \uC791\uD488\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 610472546627584
    m_Localized: "\uCE74\uAE30\uD2F0\uAC04\uC758 \uB0A0\uC740 \uBC14\uD0C4\uC758
      \uD568\uB77D\uC744 \uAE30\uB150\uD569\uB2C8\uB2E4. 7\uB9CC \uBA85\uC774 \uB118\uB294
      \uD544\uB9AC\uD540 \uBC0F \uBBF8\uAD6D \uD3EC\uB85C\uB4E4\uC774 \uC77C\uBCF8\uAD70\uC5D0
      \uD56D\uBCF5\uD588\uC73C\uBA70, \uC774 \uC911 6\uB9CC \uBA85 \uC774\uC0C1\uC774
      \uD544\uB9AC\uD540 \uAD70\uC778\uC774\uC5C8\uC2B5\uB2C8\uB2E4. \uD56D\uBCF5\uC740
      \uD544\uB9AC\uD540\uACFC \uBBF8\uAD6D\uAD70\uC758 \uB9C8\uC9C0\uB9C9 \uBC29\uC5B4\uC120\uC774\uC5C8\uB358
      \uBC14\uD0C4\uC5D0\uC11C \uC774\uB8E8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 610739056898048
    m_Localized: "\u2018\uC6B0\uB098 \uBD88\uB77C\uCF00\uB0D0\u2019(\uBD88\uB77C\uCE78\uC758
      \uC5EC\uC131)\uC740 \uB8E8\uB098\uAC00 1894\uB144 \uD544\uB9AC\uD540\uC73C\uB85C
      \uB3CC\uC544\uC654\uC744 \uB54C \uADF8\uB9B0 \uC791\uD488 \uC911 \uD558\uB098\uC785\uB2C8\uB2E4.
      \uC774 \uADF8\uB9BC\uC5D0\uB294 \uBD88\uB77C\uCE78 \uC5EC\uC131\uC758 \uD53C\uB0D0
      \uCC9C\uC744 \uC0AC\uC2E4\uC801\uC73C\uB85C \uBB18\uC0AC\uD55C \uB8E8\uB098\uC758
      \uC804\uD1B5\uC801 \uAE30\uBC95\uC758 \uB6F0\uC5B4\uB09C \uC19C\uC528\uAC00
      \uB4DC\uB7EC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 610899212201984
    m_Localized: "\uC774 \uC5F0\uC791\uC740 \uCE94\uBC84\uC2A4\uC5D0 \uADF8\uB824\uC9C4
      14\uC810\uC758 \uC720\uD654\uB85C, 1807\uB144 9\uC6D4 \uC77C\uB85C\uCF54\uC2A4\uC5D0\uC11C
      \uC77C\uC5B4\uB09C \uBC14\uC2DC \uBC18\uB780\uC744 \uBB18\uC0AC\uD55C \uD544\uB9AC\uD540
      \uCD5C\uCD08\uC758 \uC5ED\uC0AC\uC801 \uD68C\uD654\uB85C \uC54C\uB824\uC838
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 616644423020544
    m_Localized: "\uC2A4\uD3F4\uB9AC\uC544\uB9AC\uC6C0\uC740 \uC5B4\uB5A4 \uC0C1\uC744
      \uBC1B\uC558\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 617080647413760
    m_Localized: "\uAE08\uBA54\uB2EC"
    m_Metadata:
      m_Items: []
