  - m_Id: 217389329903616
    m_Localized: "\uB098\uB294 \uC774\uC6A9 \uC57D\uAD00\uC744"
    m_Metadata:
      m_Items: []
  - m_Id: 217425438666752
    m_Localized: "\uC77D\uC5C8\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 218534311981056
    m_Localized: "<b>1. \uC57D\uAD00\uC758 \uC218\uB77D</b>  \r\nMuseoAR \uBAA8\uBC14\uC77C
      \uC560\uD50C\uB9AC\uCF00\uC774\uC158(\uC774\uD558 \u201CApp\u201D)\uC744 \uB2E4\uC6B4\uB85C\uB4DC,
      \uC811\uADFC \uB610\uB294 \uC0AC\uC6A9\uD568\uC73C\uB85C\uC368, \uADC0\uD558\uB294
      \uBCF8 \uC57D\uAD00\uC5D0 \uAD6C\uC18D\uB418\uB294 \uAC83\uC5D0 \uB3D9\uC758\uD569\uB2C8\uB2E4. 
      \r\n\uB3D9\uC758\uD558\uC9C0 \uC54A\uC73C\uC2DC\uBA74, App\uC744 \uC0AC\uC6A9\uD558\uC9C0
      \uB9C8\uC2ED\uC2DC\uC624.  \r\n\r\n<b>2. \uC11C\uBE44\uC2A4 \uC124\uBA85</b> 
      \r\nMuseoAR\uC740 \uC99D\uAC15 \uD604\uC2E4(AR) \uBAA8\uBC14\uC77C \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC73C\uB85C,
      \uC720\uBB3C\uACFC \uC804\uC2DC\uC5D0 \uB300\uD55C \uC778\uD130\uB799\uD2F0\uBE0C\uD558\uACE0
      \uB2E4\uAD6D\uC5B4 \uC815\uBCF4\uB97C \uC81C\uACF5\uD558\uC5EC \uBC15\uBB3C\uAD00
      \uACBD\uD5D8\uC744 \uD5A5\uC0C1\uC2DC\uD0A4\uB3C4\uB85D \uC124\uACC4\uB418\uC5C8\uC2B5\uB2C8\uB2E4. 
      \r\n\uC774 App\uC740 \uC815\uBCF4 \uC81C\uACF5 \uBC0F \uAD50\uC721 \uBAA9\uC801\uC73C\uB85C\uB9CC
      \uC0AC\uC6A9\uB429\uB2C8\uB2E4.  \r\n\r\n<b>3. \uC0AC\uC6A9\uC790 \uC758\uBB34</b> 
      \r\n\uADC0\uD558\uB294 \uBAA8\uB4E0 \uC801\uC6A9 \uAC00\uB2A5\uD55C \uBC95\uB960\uACFC
      \uADDC\uC815\uC744 \uC900\uC218\uD558\uC5EC App\uC744 \uC0AC\uC6A9\uD560 \uAC83\uC5D0
      \uB3D9\uC758\uD569\uB2C8\uB2E4.  \r\n\uB2E4\uB978 \uC0AC\uC6A9\uC790\uC758
      \uAE30\uB2A5 \uB610\uB294 \uC811\uADFC \uAD8C\uD55C\uC744 \uD574\uCE60 \uC218
      \uC788\uB294 \uBC29\uC2DD\uC73C\uB85C App\uC744 \uC624\uC6A9\uD574\uC11C\uB294
      \uC548 \uB429\uB2C8\uB2E4.  \r\n\r\n<b>4. \uC9C0\uC801 \uC7AC\uC0B0\uAD8C</b> 
      \r\n\uD14D\uC2A4\uD2B8, \uADF8\uB798\uD53D, \uC774\uBBF8\uC9C0, \uC18C\uD504\uD2B8\uC6E8\uC5B4,
      \uBA40\uD2F0\uBBF8\uB514\uC5B4\uB97C \uD3EC\uD568\uD558\uB418 \uC774\uC5D0
      \uAD6D\uD55C\uB418\uC9C0 \uC54A\uB294 App \uB0B4 \uBAA8\uB4E0 \uCF58\uD150\uCE20\uB294
      MuseoAR \uB610\uB294 \uADF8 \uB77C\uC774\uC120\uC2A4 \uC81C\uACF5\uC790\uC758
      \uC9C0\uC801 \uC7AC\uC0B0\uC785\uB2C8\uB2E4.  \r\n\uC0AC\uC804 \uC11C\uBA74
      \uB3D9\uC758 \uC5C6\uC774 \uC0C1\uC5C5\uC801 \uBAA9\uC801\uC73C\uB85C \uCF58\uD150\uCE20\uB97C
      \uC218\uC815, \uBC30\uD3EC, \uBCF5\uC81C \uB610\uB294 \uC0AC\uC6A9\uD560 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4.  \r\n\r\n<b>5. \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638
      \uBC0F \uB370\uC774\uD130 \uC218\uC9D1</b>  \r\nApp\uC740 \uC5B8\uC5B4 \uC124\uC815,
      \uC2A4\uCE94 \uAE30\uB85D, \uC7A5\uCE58 \uC815\uBCF4\uC640 \uAC19\uC740 \uB370\uC774\uD130\uB97C
      \uC218\uC9D1\uD558\uC5EC \uC0AC\uC6A9\uC790 \uACBD\uD5D8\uC744 \uD5A5\uC0C1\uC2DC\uD0AC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.  \r\n\uC790\uC138\uD55C \uB0B4\uC6A9\uC740
      \uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uBC29\uCE68\uC744 \uCC38\uC870\uD558\uC2ED\uC2DC\uC624. 
      \r\n\uB2F9\uC0AC\uB294 \uADC0\uD558\uC758 \uAC1C\uC778 \uC815\uBCF4\uB97C \uBCF4\uD638\uD558\uACE0
      \uCC45\uC784\uAC10 \uC788\uAC8C \uC0AC\uC6A9\uB420 \uC218 \uC788\uB3C4\uB85D
      \uCD5C\uC120\uC744 \uB2E4\uD569\uB2C8\uB2E4.  \r\n\r\n<b>6. \uCC45\uC784\uC758
      \uD55C\uACC4</b>  \r\nMuseoAR \uBC0F \uADF8 \uAC1C\uBC1C\uC790\uB294 App \uC0AC\uC6A9
      \uB610\uB294 \uC0AC\uC6A9 \uBD88\uAC00\uB85C \uC778\uD55C \uC9C1\uC811\uC801,
      \uAC04\uC811\uC801, \uC6B0\uBC1C\uC801, \uD2B9\uC218\uC801, \uACB0\uACFC\uC801
      \uC190\uD574\uC5D0 \uB300\uD574 \uCC45\uC784\uC744 \uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. 
      \r\nApp\uC5D0\uB294 \uCD94\uAC00 \uC790\uB8CC\uB97C \uC81C\uACF5\uD558\uB294
      \uC81C3\uC790 \uC6F9\uC0AC\uC774\uD2B8 \uB9C1\uD06C\uAC00 \uD3EC\uD568\uB420
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.  \r\nMuseoAR\uC740 \uD574\uB2F9 \uC678\uBD80
      \uC0AC\uC774\uD2B8\uC758 \uCF58\uD150\uCE20 \uB610\uB294 \uAC00\uC6A9\uC131\uC5D0
      \uB300\uD574 \uCC45\uC784\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.  \r\n\r\n<b>7.
      \uC5C5\uB370\uC774\uD2B8 \uBC0F \uC218\uC815</b>  \r\n\uB2F9\uC0AC\uB294 \uC0AC\uC804
      \uD1B5\uC9C0 \uC5C6\uC774 \uC5B8\uC81C\uB4E0\uC9C0 App \uBC0F \uBCF8 \uC57D\uAD00\uC744
      \uC5C5\uB370\uC774\uD2B8\uD558\uAC70\uB098 \uC218\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. 
      \r\n\uBCC0\uACBD \uC0AC\uD56D \uAC8C\uC2DC \uD6C4 App\uC744 \uACC4\uC18D \uC0AC\uC6A9\uD558\uB294
      \uACBD\uC6B0, \uADC0\uD558\uB294 \uD574\uB2F9 \uBCC0\uACBD \uC0AC\uD56D\uC744
      \uC218\uB77D\uD55C \uAC83\uC73C\uB85C \uAC04\uC8FC\uB429\uB2C8\uB2E4.  \r\n\uC815\uAE30\uC801\uC73C\uB85C
      \uC774 \uD398\uC774\uC9C0\uB97C \uD655\uC778\uD558\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4. 
      \r\n\r\n<b>8. \uC811\uADFC \uC885\uB8CC</b>  \r\nMuseoAR\uC740 \uBCF8 \uC57D\uAD00
      \uC704\uBC18 \uC2DC \uADC0\uD558\uC758 App \uC811\uADFC\uC744 \uC0AC\uC804
      \uD1B5\uC9C0 \uC5C6\uC774 \uC885\uB8CC\uD558\uAC70\uB098 \uC911\uB2E8\uD560
      \uAD8C\uB9AC\uB97C \uBCF4\uC720\uD569\uB2C8\uB2E4.  \r\n\uC885\uB8CC \uC2DC,
      \uBCF8 \uC57D\uAD00\uC5D0 \uB530\uB77C \uBD80\uC5EC\uB41C \uBAA8\uB4E0 \uAD8C\uB9AC\uB294
      \uC989\uC2DC \uC18C\uBA78\uD569\uB2C8\uB2E4.  \r\n\r\n<b>9. \uC900\uAC70\uBC95</b> 
      \r\n\uBCF8 \uC57D\uAD00\uC740 \uD544\uB9AC\uD540 \uBC95\uB960\uC5D0 \uB530\uB77C
      \uADDC\uC728\uB418\uACE0 \uD574\uC11D\uB429\uB2C8\uB2E4.  \r\n\uCDA9\uB3CC
      \uBC95 \uC6D0\uCE59\uC740 \uC801\uC6A9\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. 
      \r\n\r\n<b>10. \uC5F0\uB77D\uCC98 \uC815\uBCF4</b>  \r\n\uBCF8 \uC57D\uAD00\uACFC
      \uAD00\uB828\uD558\uC5EC \uC9C8\uBB38\uC774\uB098 \uC6B0\uB824 \uC0AC\uD56D\uC774
      \uC788\uB294 \uACBD\uC6B0 \uC544\uB798\uB85C \uBB38\uC758\uD574 \uC8FC\uC2ED\uC2DC\uC624: 
      \r\n\uC774\uBA54\uC77C: museoar2024@gmail.com  \r\n\uC8FC\uC18C: STI Academic
      Center, Alabang-Zapote Road, corner V.Guinto, Las Pi\xF1as, 1740 Metro Manila. 
      \r\n\r\n<b>11. \uBA74\uCC45 \uC870\uD56D</b>  \r\n\uC774 App\uC740 \uC5B4\uB5A0\uD55C
      \uBA85\uC2DC\uC801 \uB610\uB294 \uBB35\uC2DC\uC801 \uBCF4\uC99D \uC5C6\uC774
      \u201C\uC788\uB294 \uADF8\uB300\uB85C\u201D \uC81C\uACF5\uB429\uB2C8\uB2E4. 
      \r\nMuseoAR\uC740 App\uC774 \uC624\uB958 \uC5C6\uC774 \uB610\uB294 \uC911\uB2E8
      \uC5C6\uC774 \uC6B4\uC601\uB420 \uAC83\uC744 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. 
      \r\n\r\n<b>12. \uC0AC\uC6A9\uC790 \uD655\uC778</b>  \r\nApp\uC744 \uC0AC\uC6A9\uD568\uC73C\uB85C\uC368
      \uADC0\uD558\uB294 \uBCF8 \uC57D\uAD00\uC744 \uC77D\uACE0, \uC774\uD574\uD558\uC600\uC73C\uBA70,
      \uC774\uC5D0 \uAD6C\uC18D\uB418\uB294 \uAC83\uC5D0 \uB3D9\uC758\uD568\uC744
      \uC778\uC815\uD569\uB2C8\uB2E4.  \r\n"
