  - m_Id: 7958055505981440
    m_Localized: "\uC885\uAD50\uC801 \uBB34\uAD00\uC2EC"
    m_Metadata:
      m_Items: []
  - m_Id: 7958146568515584
    m_Localized: "\u2018\uBA54\uC2A4\uD2F0\uC0AC\u2019\uAC00 \uC804\uD558\uB294 \uC5EC\uC131\uC758
      \uBA54\uC2DC\uC9C0\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 7958252386611200
    m_Localized: "\uAC15\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 7958316987281408
    m_Localized: "\uC57D\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 7958407563276288
    m_Localized: "\uADF8\uB9BC \uC18D \uAD50\uD68C\uC758 \uAD6C\uC870\uB97C \uBCF4\uC5EC\uC8FC\uB294
      \uC8FC\uC694 \uC608\uC220 \uC694\uC18C\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 7958495677214720
    m_Localized: "\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 7958553990623232
    m_Localized: "\uBB34\uC791\uC704 \uD615\uD0DC"
    m_Metadata:
      m_Items: []
  - m_Id: 7966627581227008
    m_Localized: "\uC544\uBCA0 \uC544\uAE38\uB77C\uB974 \uD06C\uB8E8\uC988 \uC544\uBCA0
      \uC544\uAE38\uB77C \uD06C\uB8E8\uC988"
    m_Metadata:
      m_Items: []
  - m_Id: 7966672384782336
    m_Localized: "\uD30C\uBE14\uB85C \uC544\uBAA8\uB974\uC194\uB85C \uC774 \uCFE0\uC5D0\uD1A0"
    m_Metadata:
      m_Items: []
  - m_Id: 7966699798753280
    m_Localized: "\uB9AC\uCE74\uB974\uD14C \uD478\uB8E8\uAC00\uB09C"
    m_Metadata:
      m_Items: []
  - m_Id: 7967420522786816
    m_Localized: "\u3008\uD0A4\uC544\uD3EC\uC758 \uBE14\uB799 \uB098\uC790\uB80C(The
      Black Nazarene of Quiapo)\u3009 \uB294 \uC720\uD654 \uC791\uD488(oil on canvas)
      \uC73C\uB85C, \uD0A4\uC544\uD3EC \uC9C0\uC5ED\uC5D0\uC11C \uC5F4\uB9AC\uB294
      \uBE14\uB799 \uB098\uC790\uB80C \uD589\uB82C \uC911 \uD544\uB9AC\uD540 \uC0AC\uB78C\uB4E4\uC758
      \uAE4A\uC740 \uC2E0\uC559, \uD5CC\uC2E0, \uADF8\uB9AC\uACE0 \uB2E8\uACB0\uC744
      \uC0DD\uC0DD\uD558\uAC8C \uB2F4\uC544\uB0B8 \uADF8\uB9BC\uC785\uB2C8\uB2E4.
      \uC774 \uC791\uD488\uC740 \uD63C\uB780 \uC18D\uC5D0\uC11C\uB3C4 \uD568\uAED8
      \uAE30\uB3C4\uD558\uB294 \uC0AC\uB78C\uB4E4\uC758 \uBAA8\uC2B5\uC744 \uBCF4\uC5EC\uC8FC\uBA70,
      \uD544\uB9AC\uD540 \uAC00\uD1A8\uB9AD \uC2E0\uC790\uB4E4\uC758 \uAE4A\uC740
      \uC601\uC131\uC744 \uD45C\uD604\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD478\uB8E8\uAC00\uB09C(Puruganan)
      \uC740 \uC791\uD488\uC744 \uC0DD\uB3D9\uAC10 \uC788\uAC8C \uD45C\uD604\uD558\uAE30
      \uC704\uD574 \uC120, \uD615\uD0DC, \uC0C9\uC0C1, \uBA85\uC554(value), \uC9C8\uAC10,
      \uACF5\uAC04, \uADE0\uD615 \uB4F1 \uC608\uC220\uC758 \uB2E4\uC591\uD55C \uC694\uC18C\uC640
      \uC6D0\uB9AC\uB97C \uB2A5\uC219\uD558\uAC8C \uD65C\uC6A9\uD588\uC2B5\uB2C8\uB2E4.
      \uC9C1\uC120\uACFC \uBD80\uB4DC\uB7EC\uC6B4 \uACE1\uC120\uC744 \uC0AC\uC6A9\uD574
      \uAD50\uD68C\uC758 \uAC74\uCD95 \uAD6C\uC870\uC640 \uC0AC\uB78C\uB4E4\uC758
      \uC637\uC758 \uC6C0\uC9C1\uC784\uC744 \uB098\uD0C0\uB0C8\uC73C\uBA70, \uB530\uB73B\uD558\uACE0
      \uBC1D\uC740 \uC0C9\uC870\uB97C \uD1B5\uD574 \uAD50\uD68C \uCC3D\uBB38\uC5D0\uC11C
      \uB4E4\uC5B4\uC624\uB294 \uBE5B\uC744 \uD45C\uD604\uD558\uC5EC \uBC1D\uACE0
      \uD76C\uB9DD\uC801\uC778 \uBD84\uC704\uAE30\uB97C \uC870\uC131\uD588\uC2B5\uB2C8\uB2E4.
      \uACF5\uAC04\uC758 \uC0AC\uC6A9\uC740 \uC0AC\uB78C\uB4E4\uB85C \uAC00\uB4DD\uD55C
      \uD65C\uAE30\uCC2C \uC7A5\uBA74\uC744 \uBCF4\uC5EC\uC8FC\uACE0, \uC9C8\uAC10\uACFC
      \uD328\uD134\uC740 \uADF8\uB9BC\uC5D0 \uBD80\uB4DC\uB7EC\uC6C0\uACFC \uC5ED\uB3D9\uC131\uC744
      \uB354\uD574\uC90D\uB2C8\uB2E4.\n\n\uB514\uC790\uC778\uC758 \uC6D0\uB9AC\uC5D0\uC11C\uB294
      \uBD89\uC740 \uC637\uC744 \uC785\uC740 \uBE14\uB799 \uB098\uC790\uB80C\uC0C1\uC744
      \uC2E0\uC559\uACFC \uD76C\uC0DD\uC758 \uC0C1\uC9D5\uC73C\uB85C \uC911\uC2EC\uC5D0
      \uB450\uC5B4 \uAC15\uC870\uD588\uC2B5\uB2C8\uB2E4. \uD654\uAC00\uB294 \uC6C0\uC9C1\uC784\uACFC
      \uBE44\uB840\uAC10\uC744 \uD1B5\uD574 \uC2E0\uB3C4\uB4E4\uC774 \uC0C1\uC744
      \uB4E4\uC5B4 \uB098\uB974\uB294 \uC0DD\uC0DD\uD55C \uC5ED\uB3D9\uC131\uC744
      \uD45C\uD604\uD558\uC5EC \uADF8\uB4E4\uC758 \uC5F4\uC815\uACFC \uD5CC\uC2E0\uC744
      \uBD80\uAC01\uC2DC\uCF30\uC2B5\uB2C8\uB2E4.\n\n\uC804\uCCB4\uC801\uC73C\uB85C
      \uC774 \uC791\uD488\uC740 \uAE30\uBC95\uACFC \uAC10\uC815\uC774 \uC544\uB984\uB2F5\uAC8C
      \uC870\uD654\uB97C \uC774\uB8EC \uD68C\uD654\uB85C, \uD544\uB9AC\uD540 \uC0AC\uB78C\uB4E4\uC758
      \uAC15\uC778\uD568, \uB2E8\uACB0, \uADF8\uB9AC\uACE0 \uBCC0\uD568\uC5C6\uB294
      \uC2E0\uC559\uC2EC\uC744 \uBE14\uB799 \uB098\uC790\uB80C\uC744 \uD1B5\uD574
      \uAC15\uB82C\uD558\uAC8C \uBCF4\uC5EC\uC8FC\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
